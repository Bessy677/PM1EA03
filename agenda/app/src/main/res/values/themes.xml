<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AgendaContactos" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/verde_primario</item>
        <item name="colorPrimaryDark">@color/verde_oscuro</item>
        <item name="colorAccent">@color/verde_medio</item>
        <item name="colorControlActivated">@color/verde_primario</item>
        <item name="android:windowBackground">@color/verde_fondo</item>
        <item name="android:statusBarColor">@color/verde_oscuro</item>
        <item name="android:textColorPrimary">@color/negro</item>
        <item name="alertDialogTheme">@style/Dialogo.Verde</item>
    </style>

    <style name="Dialogo.Verde" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/verde_primario</item>
        <item name="android:textColorPrimary">@color/negro</item>
    </style>

    <style name="Etiqueta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/verde_oscuro</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <style name="Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_campo</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/verde_oscuro</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Boton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
